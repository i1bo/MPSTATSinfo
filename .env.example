# Скопируйте этот файл в .env и заполните. Строки с # в начале — пояснения, они не читаются.
# Пароли — латинские буквы и цифры, без символов @ : / # (они ломают строку подключения PG_DSN).

# ---------------------------------------------------------------- MPSTATS и база
MPSTATS_TOKEN=ваш_токен_mpstats

# Пароль базы PostgreSQL. На сервере (docker compose) его задаёте вы, база создаётся с ним.
PG_PASSWORD=
# Подключение к базе, пароль — тот же, что в PG_DSN.
# На сервере (docker compose):      postgresql://postgres:ПАРОЛЬ@db:5432/mpstats
# На Windows (PostgreSQL 16 локально): postgresql://postgres:ПАРОЛЬ@localhost:5433/mpstats
PG_DSN=postgresql://postgres:ПАРОЛЬ@db:5432/mpstats

# WB: последняя достоверная дата у MPSTATS (данные запаздывают ~2-3 недели)
WB_DATA_UNTIL=2026-09-08

# Необязательные настройки выгрузки
PAGE_SIZE=5000
QUOTA_RESERVE=300
PAUSE_SEC=1
HTTP_TIMEOUT=600

# ---------------------------------------------------------------- сайт
# Вход по паролю: без WEB_PASSWORD сайт открыт всем, кто достучится до порта.
# WEB_USER можно не задавать — тогда спрашивается только пароль. Смена пароля сбрасывает все входы.
WEB_USER=
WEB_PASSWORD=
# сколько дней помнить вход
WEB_SESSION_DAYS=30
# порт сайта на сервере (docker compose)
WEB_PORT=8000
# память DuckDB: сайт / сборка файла. Сервер 32 ГБ с другими проектами: 10GB / 12GB; ноутбук 16 ГБ: 6GB / 8GB
DUCKDB_MEMORY=10GB
DUCKDB_BUILD_MEMORY=12GB
