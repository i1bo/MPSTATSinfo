# Скопируйте этот файл в .env и заполните
MPSTATS_TOKEN=ваш_токен_mpstats
# PostgreSQL 16 — порт 5433 (17-й — 5432)
PG_DSN=postgresql://postgres:ПАРОЛЬ@localhost:5433/mpstats

# Необязательные настройки
PAGE_SIZE=5000
QUOTA_RESERVE=300
PAUSE_SEC=1
HTTP_TIMEOUT=600

# WB: последняя достоверная дата у MPSTATS (данные запаздывают ~2-3 недели)
WB_DATA_UNTIL=2026-09-08

# ---------------------------------------------------------------- сайт
# Вход по паролю: без WEB_PASSWORD сайт открыт всем, кто достучится до порта.
# WEB_USER можно не задавать — тогда спрашивается только пароль. Смена пароля сбрасывает все входы.
WEB_USER=
WEB_PASSWORD=
# сколько дней помнить вход
WEB_SESSION_DAYS=30
# порт сайта на сервере (docker compose)
WEB_PORT=8000
# память DuckDB: сайт / сборка файла (не больше ~70% памяти сервера)
DUCKDB_MEMORY=6GB
DUCKDB_BUILD_MEMORY=8GB
# в Docker с Postgres на том же сервере: PG_DSN=postgresql://postgres:ПАРОЛЬ@host.docker.internal:5433/mpstats
